# EditorConfig for netflow-java project
# Inherits from root .editorconfig

root = false

# Groovy Spock test files - enforce indented test blocks
[*Spec.groovy]
indent_style = space
indent_size = 4
# Spock convention: indent labels (given, when, then, expect, where, etc.) at method level
# and indent the code blocks beneath them by 4 more spaces
